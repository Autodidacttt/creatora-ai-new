# Copy to .env.local and fill in. Never commit real values.

# Public (reach the browser via next.config.ts env mapping; safe by design)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only (route handlers, server actions, scripts). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Postgres connection string (Dashboard -> Connect -> Session pooler). Scripts only: migrations + RLS checks.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Optional: AI brief builder. Without it the brief form falls back to manual entry.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: AI Creator Finder. "true" sends creator profile + portfolio text to Gemini (embeddings and
# "Why this creator?"). Leave off until that's approved; the finder then ranks by tags + keywords.
AI_FINDER_SEND_CREATOR_DATA=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Account verification (all optional; demo modes by default — never commit real values)
# IDENTITY_SECRET: peppers phone / ID-number hashes and encrypts phones. Derived from SUPABASE_SECRET_KEY if empty;
# set it before rotating that key.
IDENTITY_SECRET=
# Phone OTP: without Twilio the code is shown in the UI ("Demo OTP, no SMS sent")
OTP_MODE=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
DEFAULT_PHONE_COUNTRY_CODE=+91
# Company invitations: demo = no email sent, the admin copies the link
EMAIL_SEND_MODE=demo
RESEND_API_KEY=
EMAIL_FROM=Creatora <verify@your-domain.example>
MOCK_IDENTITY_API_KEY=
# Gemini "Find official contacts" (sends only company name / domain / industry / address)
AI_CONTACT_DISCOVERY_ENABLED=false
ID_RETENTION_DAYS=30
DEMO_ID_NOTICE=true
CRON_SECRET=

# Optional: public site URL used for auth email redirects (defaults to the request origin)
SITE_URL=http://localhost:3000
